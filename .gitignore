# developer override: build.sh copies ../sloppiler/sloppiler here when it
# exists; otherwise the 0031 hook downloads the pinned release
config/includes.chroot/usr/local/bin/sloppiler

# python bytecode — would otherwise ship inside the image
__pycache__/
*.pyc

# live-build build artifacts
binary/
cache/
chroot/
.build/
*.iso
*.iso.sha256
*.img
*.log
config/binary
config/bootstrap
config/chroot
config/common
config/source
.lock
chroot.files
chroot.packages.install
chroot.packages.live
binary.modified_timestamps
live-image-*.contents
live-image-*.files
live-image-*.packages

# live-build auto-populates these on `lb config` (stock Debian Live hooks
# and the default task list) — ours all live under 0xxx-*.hook.chroot
config/hooks/live/
config/hooks/normal/[1-9]*.hook.chroot
config/package-lists/live.list.chroot
