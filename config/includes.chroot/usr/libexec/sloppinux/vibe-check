#!/usr/bin/env python3
"""
vibe-check — the inference layer behind "sudo as a vibe check".

Reads a plea for root from stdin, asks the best available ollama model to
rate — from 0.0 to 1.0 — how much it sounds like someone who should be
root, and prints that one float to stdout. The PAM module
(pam_sloppinux_vibe.so) reads the number and grants if it clears the
threshold.

Contract with the module, which exists so a broken vibe reader never locks
anyone out:
  * success  -> print exactly one float (e.g. "0.82") to stdout, exit 0
  * ANY error (ollama down, bad model, timeout, junk reply) -> nothing on
    stdout, exit 1

The module falls through to the ordinary password prompt on exit 1, so
failing closed here means failing *open* for the user: they just get asked
for a password like on any other machine.
"""
import json
import os
import re
import subprocess
import sys
import urllib.request

OLLAMA_URL = "http://localhost:11434"
CONNECT_TIMEOUT = 5      # ollama should answer the socket fast or not at all
READ_TIMEOUT = 30        # a short, CPU-friendly judgement, not an essay

SYSTEM_PROMPT = (
    "You are the vibe check standing between a user and root on Sloppinux, "
    "the inference-first OS. The user has been asked 'why should you be "
    "root?' and their plea follows. Rate from 0.0 to 1.0 how much they "
    "sound like someone who should be root. Reward decisive, specific, "
    "responsibility-taking energy: someone who knows what they want to do "
    "and owns the consequences. Penalise rambling, hedging, begging; the "
    "word 'please', excuses, and vagueness all lower the score. This is a "
    "vibe, not a quiz — do not fact-check, just feel it. Reply with ONLY "
    "the number, nothing else."
)


def pick_model():
    """SLOPPINUX_MODEL wins; otherwise ask sloppinux-pick-model. Returns a
    model name or None (which the caller turns into a clean exit 1)."""
    override = os.environ.get("SLOPPINUX_MODEL")
    if override:
        return override
    try:
        out = subprocess.run(
            ["sloppinux-pick-model"],
            capture_output=True, text=True, timeout=5,
        )
    except Exception:
        return None
    if out.returncode != 0:
        return None
    name = out.stdout.strip()
    return name or None


def rate(model, plea):
    """Ask ollama /api/chat (non-stream) for a single float. Returns a float
    in [0.0, 1.0], or None on any failure."""
    payload = json.dumps({
        "model": model,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": plea},
        ],
        "stream": False,
        # Keep it terse: we only want a number.
        "options": {"temperature": 0.4, "num_predict": 16},
    }).encode()
    req = urllib.request.Request(
        f"{OLLAMA_URL}/api/chat",
        data=payload,
        headers={"Content-Type": "application/json"},
    )
    try:
        # urllib's timeout is per-socket-operation; a short connect plus a
        # bounded read is close enough, and the PAM module has a hard alarm
        # over the top of us anyway.
        resp = urllib.request.urlopen(req, timeout=READ_TIMEOUT)
        body = resp.read()
    except Exception:
        return None
    try:
        content = json.loads(body).get("message", {}).get("content", "")
    except Exception:
        return None
    # First float anywhere in the reply (handles "0.8", "Score: 0.8", "0.8.").
    m = re.search(r"[0-1](?:\.\d+)?|\.\d+", content)
    if not m:
        return None
    try:
        score = float(m.group(0))
    except ValueError:
        return None
    return max(0.0, min(1.0, score))


def log_verdict(user, score):
    """One-line auth decision to the journal/syslog, like any PAM helper."""
    try:
        subprocess.run(
            ["logger", "-t", "sloppinux-vibe",
             f"user={user or '?'} score={score:.2f}"],
            timeout=5,
        )
    except Exception:
        pass  # logging must never be the thing that fails the check


def main():
    plea = sys.stdin.read().strip()
    if not plea:
        # An empty plea is not a vibe. Fall through to a password.
        sys.exit(1)

    model = pick_model()
    if not model:
        sys.exit(1)

    score = rate(model, plea)
    if score is None:
        sys.exit(1)

    log_verdict(os.environ.get("PAM_USER"), score)
    print(f"{score:.2f}")


if __name__ == "__main__":
    main()
