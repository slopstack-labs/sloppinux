#!/usr/bin/env python3
"""
sloppinux-raccoon-oomd

Userspace OOM killer with taste. When memory runs low, the raccoon walks
through everything that is holding a meaningful amount of RAM, decides
which process it finds LEAST INTERESTING, kills that one, and announces the
verdict: a desktop notification to every logged-in graphical user, a wall
message to every terminal, the journal, and a verdict file in /run.

Deterministic operating systems pick the process with the highest
oom_score. Sloppinux picks the most boring one. Memory hoarding is boring,
so a big process is still the likeliest victim, but shiny things, kin, and
anything a human is visibly typing into get a stay of execution.

The raccoon deliberately does NOT ask the LLM. Under memory pressure the
LLM is usually the problem, and loading a model to decide which process to
kill is the single funniest way to die.

Runs as root from sloppinux-raccoon-oomd.service. Knobs (environment, or
/etc/default/sloppinux-raccoon-oomd):

  SLOPPINUX_OOMD_MEM_PCT    act when MemAvailable drops below this % (5)
  SLOPPINUX_OOMD_SWAP_PCT   ...and free swap is below this % (10); a machine
                            without swap counts as 0 % free
  SLOPPINUX_OOMD_PSI_FULL   also act when PSI memory "full avg10" is at least
                            this while MemAvailable < 3x the threshold (60)
  SLOPPINUX_OOMD_NOTIFY     1 = desktop notification per graphical user (1)
  SLOPPINUX_OOMD_WALL       1 = wall(1) the verdict to every terminal (1)
  SLOPPINUX_OOMD_DRY_RUN    1 = announce, but don't actually kill (0)

Kernel OOM remains the backstop: the default threshold is well above the
point where the kernel would step in, so the raccoon gets the first bite.

  sloppinux-raccoon-oomd             run the daemon
  sloppinux-raccoon-oomd --judge     rank who would die right now, kill nothing
  sloppinux-raccoon-oomd --judge --announce
                                     ...and send the (fake) verdict out (root)
"""
import argparse
import ctypes
import html
import json
import os
import pwd
import random
import select
import signal
import subprocess
import sys
import time

RUN_DIR = "/run/sloppinux-raccoon-oomd"
LAST_VERDICT = os.path.join(RUN_DIR, "last-verdict.json")
VERDICT_LOG = os.path.join(RUN_DIR, "verdicts.jsonl")
VERDICT_LOG_MAX_BYTES = 256 * 1024
SOUND_FILE = "/usr/share/sounds/sloppinux/stereo/pipe.oga"

CLK_TCK = os.sysconf("SC_CLK_TCK")
PAGE_SIZE = os.sysconf("SC_PAGE_SIZE")
PF_KTHREAD = 0x00200000
MIB = 1024 * 1024
GIB = 1024 * MIB

# Only processes in the top N by RSS (and above a floor) are considered:
# killing an uninteresting 4 MB daemon would be a fine verdict and a useless
# one, because it frees nothing.
CANDIDATE_POOL = 25
MIN_CANDIDATE_RSS = 32 * MIB
# ...and of those, only ones holding at least 1/N of the biggest one's anon.
WORTH_IT_FRACTION = 4

POLL_IDLE_SECS = 1.0
POLL_TENSE_SECS = 0.1
DEATH_WAIT_SECS = 5.0
COOLDOWN_SECS = 1.0
# A process that was sentenced but hasn't died (stuck in D state) isn't
# picked again for this long; the raccoon moves on to the next most boring.
RESENTENCE_SECS = 15.0

# The raccoon is feral, not stupid. These are load-bearing: killing them
# ends the session (or the boot, or the install) rather than freeing memory.
PROTECTED_EXACT = {
    "systemd", "(sd-pam)", "init", "dbus-daemon", "dbus-broker",
    "dbus-broker-lau", "gnome-shell", "gnome-session-b", "gnome-session-c",
    "gnome-session-i", "Xwayland", "Xorg", "gdm", "gdm-session-wor",
    "gdm-wayland-ses", "gdm-x-session", "agetty", "login", "sshd", "polkitd",
    "NetworkManager", "wpa_supplicant", "dpkg", "apt", "apt-get",
    "unattended-upgr", "calamares", "live-config", "plymouthd", "cryptsetup",
    "sloppinux-racco",  # comm is truncated to 15 chars; that's us
}
PROTECTED_PREFIX = ("systemd-",)

# (kind, needle, interest delta, reason). Matched against the lowercased
# comm and argv[0] basename. kind: "exact", "prefix", "sub" (substring).
# Positive = interesting = spared. Every reason ends up in a verdict, so
# write them for the stakeholder reading the notification.
