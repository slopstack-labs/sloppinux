CATCHPHRASES = [
    "Nothing personal. It just wasn't shiny.",
    "The raccoon has spoken. The raccoon would like a snack now.",
    "Sentenced by a jury of one trash panda.",
    "It was sniffed, found wanting, and knocked off the counter.",
    "Feed the raccoon and it might be more lenient next time.",
    "This verdict is final and was reached without any determinism.",
    "Memory has been liberated. Interestingness has been preserved.",
