#!/usr/bin/env python3
"""
sloppinux-model-autopull

First-boot capability-surface expansion for INSTALLED Sloppinux systems.

The ISO ships one small baked model so `ai` works offline on any hardware.
Once installed onto real disk, this pulls a larger coding model sized to
the machine's total RAM, plus one about half its size, so that
sloppinux-pick-model has something worth picking both on a quiet machine
and when a browser has eaten most of the memory.

    sloppinux-model-autopull --list     show the ladder and this machine's rung
    sloppinux-model-autopull --dry-run  say what would be pulled, pull nothing

The ladder can be replaced with /etc/sloppinux/model-tiers.conf: one rung
per line, "MIN_RAM_GIB MODEL DOWNLOAD_GB", # for comments.

Runs from sloppinux-model-autopull.service. Behaviour:
  * live session (/run/live/medium exists): do nothing. The overlay there is
    RAM-backed, so a multi-GB pull would eat the memory the model needs.
  * no ollama API / no network: exit 0 WITHOUT the marker, retry next boot.
  * pull fails while online: count it; after MAX_FAILURES, give up for good.
  * success, already present, or machine too small: write the marker.
Delete MARKER (and FAILURES) to make it run again.
"""
import json
import os
import shutil
import sys
import time
import urllib.error
import urllib.request

OLLAMA_URL = "http://127.0.0.1:11434"
REGISTRY_PROBE_URL = "https://registry.ollama.ai/v2/"
STATE_DIR = "/var/lib/sloppinux"
MARKER = os.path.join(STATE_DIR, "model-autopull.done")
FAILURES = os.path.join(STATE_DIR, "model-autopull.failures")
MAX_FAILURES = 3
# Where ollama.service (User=ollama, HOME=/usr/share/ollama) keeps blobs;
# only used to check free disk space before committing to a 20 GB download.
MODELS_DIR = "/usr/share/ollama/.ollama/models"

OLLAMA_WAIT_SECS = 120
NETWORK_WAIT_SECS = 120
DISK_HEADROOM_GB = 5.0
# MemTotal is always a bit under the number on the box (firmware, iGPU
# carve-outs), so an "8 GB" laptop reports ~7.6 GiB. Without slack every
# machine would land one tier lower than intended.
RAM_SLACK_GIB = 0.75

# (minimum total RAM in GiB, model, download size in GB)
# Largest first. All of them are coding models: the job here is turning
# typos into shell commands and letting `ai` drive a root shell, and that
# is what they are trained on. Same family as the baked qwen2.5-coder:1.5b
# up to 14b, then the agentic coders. Sizes are the default (Q4) tags as
# the ollama registry reported them in October 2026; they drive the disk
# check and the choice of fallback, so rough is fine.
TIERS = [
    (40, "qwen3-coder:30b", 18.6),
    (28, "devstral:24b", 14.3),
    (20, "qwen2.5-coder:14b", 9.0),
    (12, "qwen2.5-coder:7b", 4.7),
    (6, "qwen2.5-coder:3b", 1.9),
]
TIERS_FILE = "/etc/sloppinux/model-tiers.conf"
# The second model pulled is the largest rung no bigger than this fraction
# of the first. sloppinux-pick-model takes the largest model that fits in
# FREE RAM, so without it a busy machine drops straight from its best model
# to the 1 GB baked one.
FALLBACK_FRACTION = 0.55


def log(msg):
    # stdout goes to the journal via the unit; flush so lines aren't held
    # back for the duration of a multi-GB download.
    print(msg, flush=True)


def write_marker(reason):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(MARKER, "w") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {reason}\n")
    try:
        os.remove(FAILURES)
    except FileNotFoundError:
        pass


def record_failure():
    os.makedirs(STATE_DIR, exist_ok=True)
    try:
        with open(FAILURES) as f:
            count = int(f.read().strip() or 0)
    except (FileNotFoundError, ValueError):
        count = 0
    count += 1
    with open(FAILURES, "w") as f:
        f.write(f"{count}\n")
    return count


def total_ram_gib():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) / (1024 * 1024)
    return 0.0


def free_disk_gb(path):
    # The models dir may not exist yet if nothing was baked; walk up to the
    # nearest existing parent, which is on the same filesystem.
    while not os.path.exists(path) and path != "/":
        path = os.path.dirname(path)
    return shutil.disk_usage(path).free / 1e9


def ollama_tags():
    with urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=5) as r:
        return [m.get("name", "") for m in json.loads(r.read()).get("models", [])]


def wait_for_ollama():
    deadline = time.monotonic() + OLLAMA_WAIT_SECS
    while True:
        try:
            return ollama_tags()
        except (urllib.error.URLError, OSError, ValueError):
            if time.monotonic() >= deadline:
                return None
            time.sleep(3)


def wait_for_registry():
    """True once the ollama registry is reachable at all (any HTTP answer)."""
    deadline = time.monotonic() + NETWORK_WAIT_SECS
    while True:
        try:
            urllib.request.urlopen(REGISTRY_PROBE_URL, timeout=10).close()
            return True
        except urllib.error.HTTPError:
            # 401/404/etc: we reached it, which is all we wanted to know.
            return True
        except (urllib.error.URLError, OSError):
            if time.monotonic() >= deadline:
                return False
            time.sleep(10)


def normalize(name):
    return name if ":" in name else f"{name}:latest"


def load_tiers():
    """The ladder, largest first: from TIERS_FILE if it holds at least one
    valid rung, otherwise the built-in one."""
    try:
        with open(TIERS_FILE) as f:
            lines = f.read().splitlines()
    except OSError:
        return TIERS
    tiers = []
    for n, line in enumerate(lines, 1):
        fields = line.split("#", 1)[0].split()
        if not fields:
            continue
        try:
            min_gib, model, size_gb = float(fields[0]), fields[1], float(fields[2])
            if len(fields) != 3 or min_gib < 0 or size_gb <= 0:
                raise ValueError
        except (ValueError, IndexError):
            log(f"{TIERS_FILE}:{n}: expected 'MIN_RAM_GIB MODEL DOWNLOAD_GB', ignoring")
            continue
        tiers.append((min_gib, model, size_gb))
    if not tiers:
        log(f"{TIERS_FILE} has no usable rungs, using the built-in ladder")
        return TIERS
    return sorted(tiers, key=lambda t: t[0], reverse=True)


def plan(tiers, ram_gib, free_gb, quiet=False):
    """What this machine should have: [(model, size_gb)], best first.

    The first entry is the largest model whose rung the RAM reaches and
    that fits on disk; the second, if any, is its half-size fallback. Empty
    when the machine is too small for any rung."""
    say = (lambda _msg: None) if quiet else log
    wanted = []
    budget = free_gb - DISK_HEADROOM_GB
    for min_gib, model, size_gb in tiers:
        if ram_gib + RAM_SLACK_GIB < min_gib:
            continue
        if wanted and size_gb > wanted[0][1] * FALLBACK_FRACTION:
            continue
        if size_gb > budget:
            say(f"skipping {model}: needs ~{size_gb:.0f} GB more than the "
                f"{budget:.1f} GB the disk can spare")
            continue
        wanted.append((model, size_gb))
        budget -= size_gb
        if len(wanted) == 2:
            break
    return wanted


def show_ladder(tiers):
    ram = total_ram_gib()
    free = free_disk_gb(MODELS_DIR)
    wanted = plan(tiers, ram, free, quiet=True)
    source = TIERS_FILE if tiers is not TIERS else "built in"
    print(f"# {ram:.1f} GiB RAM, {free:.1f} GB free for models, ladder: {source}")
    for min_gib, model, size_gb in tiers:
        role = ""
        if wanted and model == wanted[0][0]:
            role = "  <- this machine"
        elif len(wanted) > 1 and model == wanted[1][0]:
            role = "  <- fallback for when RAM is busy"
        print(f"{min_gib:>4.0f} GiB and up  {model:<22} {size_gb:5.1f} GB{role}")
    if not wanted:
        print("# nothing here fits: this machine keeps the baked model only")


def pull(model):
    """Pull via the ollama API, logging coarse progress. Raises on failure."""
    req = urllib.request.Request(
        f"{OLLAMA_URL}/api/pull",
        data=json.dumps({"model": model, "stream": True}).encode(),
        headers={"Content-Type": "application/json"},
    )
    last_status = None
    last_pct = {}
    # The timeout is per socket read, not for the whole download: ollama
    # streams a status line at least every few seconds while it's working,
    # so 10 minutes of silence means it's stuck.
    with urllib.request.urlopen(req, timeout=600) as r:
        for raw in r:
            raw = raw.strip()
            if not raw:
                continue
            msg = json.loads(raw)
            if "error" in msg:
                raise RuntimeError(msg["error"])
            status = msg.get("status", "")
            total = msg.get("total") or 0
            completed = msg.get("completed") or 0
            digest = msg.get("digest")
            if digest and total:
                pct = int(completed * 100 / total) // 10 * 10
                if pct != last_pct.get(digest):
                    last_pct[digest] = pct
                    log(f"{model}: {status} {pct}% of {total / 1e9:.2f} GB")
            elif status != last_status:
                log(f"{model}: {status}")
            last_status = status
    if last_status != "success":
        raise RuntimeError(f"pull stream ended with status {last_status!r}")


def main():
    tiers = load_tiers()
    if "--list" in sys.argv[1:]:
        show_ladder(tiers)
        return 0
    dry_run = "--dry-run" in sys.argv[1:]

    if os.path.exists("/run/live/medium") and not dry_run:
        log("live session detected, not pulling onto a RAM-backed overlay")
        return 0
    if os.path.exists(MARKER) and not dry_run:
        log(f"already done ({MARKER} exists)")
        return 0

    tags = wait_for_ollama()
    if tags is None:
        log(f"ollama API not reachable at {OLLAMA_URL} after {OLLAMA_WAIT_SECS}s, "
            "will retry next boot")
        return 0

    ram = total_ram_gib()
    free = free_disk_gb(MODELS_DIR)
    log(f"total RAM {ram:.1f} GiB, {free:.1f} GB free for models, "
        f"installed models: {', '.join(tags) or 'none'}")

    wanted = plan(tiers, ram, free)
    if not wanted:
        log("no larger model fits this machine, keeping the baked model only")
        if not dry_run:
            write_marker("nothing-fits")
        return 0

    present = {normalize(t) for t in tags}
    missing = [model for model, _size in wanted if normalize(model) not in present]
    log("plan: " + ", ".join(
        f"{model} ({'present' if model not in missing else f'{size:.1f} GB to pull'})"
        for model, size in wanted))
    if dry_run:
        return 0
    if not missing:
        write_marker("present " + " ".join(model for model, _size in wanted))
        return 0

    if not wait_for_registry():
        log(f"no network (registry unreachable after {NETWORK_WAIT_SECS}s), "
            "will retry next boot")
        return 0

    for model in missing:
        log(f"pulling {model} for a {ram:.0f} GiB machine (this can take a while)")
        try:
            pull(model)
        except Exception as e:  # network drop, registry error, disk full, ...
            n = record_failure()
            if n >= MAX_FAILURES:
                log(f"pull of {model} failed ({e}); {n} failures, giving up. "
                    f"Remove {MARKER} and {FAILURES} to try again.")
                write_marker(f"gave-up {model}")
            else:
                log(f"pull of {model} failed ({e}); attempt {n}/{MAX_FAILURES}, "
                    "will retry next boot")
            return 0
        log(f"{model} is ready; sloppinux-pick-model will use it when RAM allows")

    write_marker("pulled " + " ".join(missing))
    return 0


if __name__ == "__main__":
    sys.exit(main())
