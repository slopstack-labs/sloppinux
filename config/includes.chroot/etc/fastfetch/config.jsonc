{
  "logo": {
    "type": "file",
    "source": "/etc/fastfetch/sloppinux.txt",
    // Raw SGR truecolour. 1-3 are the slabs' top faces (top to bottom),
    // 4/5, 6/7 and 8/9 their left and right flanks. Regenerate the art with
    // scripts/gen-fastfetch-logo.py, which keeps the same numbering.
    "color": {
      "1": "38;2;82;190;222",
      "2": "38;2;139;108;236",
      "3": "38;2;92;86;204",
      "4": "38;2;0;150;199",
      "5": "38;2;0;112;160",
      "6": "38;2;98;40;180",
      "7": "38;2;62;22;140",
      "8": "38;2;58;34;150",
      "9": "38;2;38;20;118"
    }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "magenta" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "OS" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell",    "key": "Shell" },
    { "type": "de",       "key": "DE" },
    { "type": "wm",       "key": "WM" },
    { "type": "terminal", "key": "Terminal" },
    "separator",
    { "type": "cpu",      "key": "CPU" },
    { "type": "gpu",      "key": "GPU" },
    { "type": "memory",   "key": "Memory" },
    { "type": "disk",     "key": "Disk",   "folders": "/" },
    "separator",
    { "type": "colors",   "paddingLeft": 2, "block": { "width": 3 } }
  ]
}
