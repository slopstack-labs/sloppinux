#!/bin/bash
# Installs ollama: CPU-only by default, with every GPU runner for --gpu.
# Requires internet access during build (live-build has it by default).
#
# Deliberately not `curl https://ollama.com/install.sh | sh`. That script
# inspects the BUILD host: on an AMD box it adds the ROCm bundle (~2.6 GB),
# on an NVIDIA box it apt-installs CUDA drivers, so the ISO depended on
# whoever built it. Its main tarball also carries CUDA 12 + 13 and Vulkan
# runners (~2.1 GB). All of that was ~4.7 GB of a ~5.8 GB squashfs, for a
# distro whose default model runs fine on a CPU. We do the three things we
# actually need from it ourselves: unpack, create the user, write the unit.
#
# SLOPPINUX_GPU=1 (build.sh --gpu) keeps CUDA and Vulkan and adds ROCm, the
# same set whatever machine builds it. No NVIDIA kernel driver comes with
# it: CUDA needs nvidia-driver installed on the target; ROCm and Vulkan
# use the in-tree amdgpu and Mesa.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[ -f /etc/sloppinux-build.env ] && . /etc/sloppinux-build.env
GPU="${SLOPPINUX_GPU:-0}"

PREFIX=/usr/local
LIBDIR="$PREFIX/lib/ollama"
URL="https://ollama.com/download/ollama-linux-amd64.tar.zst"
ROCM_URL="https://ollama.com/download/ollama-linux-amd64-rocm.tar.zst"
# GPU runner directories inside lib/ollama. Without --gpu they are excluded
# on unpack, and pruned from an existing install so `build.sh --refresh`
# can turn a GPU chroot into a CPU one.
GPU_RUNNERS=('cuda_*' 'rocm*' 'vulkan*')

have_gpu_runners() {
    compgen -G "$LIBDIR/cuda_*" >/dev/null && compgen -G "$LIBDIR/rocm*" >/dev/null
}

# Skipped when ollama is already in the chroot (with the runners, for
# --gpu), so `build.sh --refresh` can rerun this hook without downloading
# the whole thing again.
if command -v ollama >/dev/null 2>&1 && { [ "$GPU" != 1 ] || have_gpu_runners; }; then
    echo "==> ollama already installed, not reinstalling"
else
    excludes=()
    if [ "$GPU" = 1 ]; then
        echo "==> Installing ollama (CPU + CUDA, ROCm and Vulkan runners)"
    else
        echo "==> Installing ollama (CPU only)"
        for g in "${GPU_RUNNERS[@]}"; do
            excludes+=(--exclude "lib/ollama/$g")
        done
    fi
    install -o0 -g0 -m755 -d "$PREFIX/bin" "$LIBDIR"
    curl -fsSL --retry 3 "$URL" | tar --zstd -x -C "$PREFIX" "${excludes[@]}"
    if [ "$GPU" = 1 ]; then
        curl -fsSL --retry 3 "$ROCM_URL" | tar --zstd -x -C "$PREFIX"
    fi
fi

[ "$GPU" = 1 ] || for g in "${GPU_RUNNERS[@]}"; do
    # shellcheck disable=SC2086  # $g is a glob on purpose
    for d in "$LIBDIR"/$g; do
        [ -e "$d" ] || continue
        echo "==> Removing GPU runner $d ($(du -sh "$d" | cut -f1))"
        rm -rf "$d"
    done
done

# A chroot built with the old install script on an NVIDIA host may still
# carry its contrib.list (every sources.list line again, "contrib contrib").
CONTRIB_LIST=/etc/apt/sources.list.d/contrib.list
if [ -f "$CONTRIB_LIST" ] && grep -Eq '^deb .*[[:space:]]contrib([[:space:]]|$)' /etc/apt/sources.list; then
    echo "==> Removing redundant $CONTRIB_LIST left by the ollama installer"
    rm -f "$CONTRIB_LIST"
fi

# Same account and unit the upstream script creates; 0014 (model bake)
# relies on this user and its HOME being /usr/share/ollama.
if ! id ollama >/dev/null 2>&1; then
    useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
fi

cat > /etc/systemd/system/ollama.service <<EOF
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=$PREFIX/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=$PATH"

[Install]
WantedBy=default.target
EOF

# Enable the ollama systemd service so it starts on boot
systemctl enable ollama
